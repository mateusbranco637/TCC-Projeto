PORT=3000

# String de conexão do PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/psicompany

# Segredo usado para assinar os tokens JWT — troque por um valor forte e único
JWT_SECRET=troque_por_um_segredo_bem_forte_aqui
JWT_EXPIRES_IN=8h

# Origem permitida para requisições do frontend (CORS)
FRONTEND_ORIGIN=http://localhost:5500
